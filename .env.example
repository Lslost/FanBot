# ============================================================================
# 配置模板
#
#     cp .env.example .env
#
# 说明：
#   * 配置项名不区分大小写，NoneBot 用 pydantic 解析，所以 list / dict / bool
#     要写成 JSON（例如 SUPERUSERS=["123"]、ONEBOT_WS_URLS=["ws://..."])。
#   * 不想要的配置项请整行注释掉，不要写 `XXX=None`：dotenv 会把它读成
#     字符串 "None"，插件里 `if xxx:` 判空时是真值，行为会变得莫名其妙。
#   * 也别写「空值 + 行内注释」（`XXX=    # 说明`）：值非空时 dotenv 会去掉
#     行内注释，但值为空时不会，整段注释会被当成 XXX 的值。
#   * 下面带「必填」字样的是插件没有默认值、不填会直接加载失败的项。
# ============================================================================

# ------------------------------------------------------------------ NoneBot 本体
# 驱动，`~` 前缀表示「可选」，某个驱动缺依赖时只警告不报错
DRIVER=~fastapi+~httpx+~websockets+~aiohttp
HOST=127.0.0.1
PORT=3939
LOG_LEVEL=INFO
# 超级用户（权限 5），llmchat / plugin_manager 等都靠它判断权限
SUPERUSERS=["10001"]
# 机器人昵称，多个别名用 JSON 数组；maimaidx 的 bot_name 默认取第一个
NICKNAME=["马歇尔"]
# 命令前缀与分隔符，空字符串表示「不需要前缀」，即普通聊天也算命令
COMMAND_START=["/", ""]
COMMAND_SEP=[".", " "]
# 会话（等待用户下一条消息）的过期时间
SESSION_EXPIRE_TIMEOUT=00:02:00
# 请求协议端的超时时间（秒）。parser 下载音视频时建议调大，例如 120.0
API_TIMEOUT=120.0

# localstore 的数据目录：
#   true  = 用「当前工作目录」（即 ./data、./cache、./config），部署时比较省心
#   不写  = 用系统目录（Linux 下是 ~/.local/share/<项目名>）
# 注意换这个值等于换数据目录，插件会读不到之前的数据（要重新下载 / 重新生成），
# 已经跑过的机器别随手改。
LOCALSTORE_USE_CWD=true
# 也可以分别指定，不写则跟着 LOCALSTORE_USE_CWD 走
# LOCALSTORE_DATA_DIR=./data
# LOCALSTORE_CACHE_DIR=./cache
# LOCALSTORE_CONFIG_DIR=./config

# --------------------------------------------------------- OneBot v11（QQ 协议端）
# onebot v11 适配器的反向 WS 路由是固定的，协议端连到：
#     ws://<机器人IP>:<PORT>/onebot/v11/ws
# 下面这个键是历史配置项，当前版本不读取，留在这里只是备忘
# ONEBOT_WS_REVERSE_URL="ws://127.0.0.1/onebot/v11/ws"
#
# 反过来让机器人主动连协议端（正向 WS）时填这个，多个用 JSON 数组
# ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
#
# 适配器真正读取的授权配置项名字带 v11 前缀
# ONEBOT_V11_ACCESS_TOKEN=
# ONEBOT_V11_SECRET=

# ------------------------------------------------- htmlrender（arcaea-sticker 用）
# 需要 nonebot-plugin-htmlrender<0.8（见 requirements.txt）。
# 0.8 把配置项改成了 RENDER__PROVIDER / RENDER__PROVIDER_CONFIG 这种结构，
# 并且检测到下面的旧键会直接抛错，所以升级 htmlrender 时记得一起改。
RENDER_BACKEND="playwright"
RENDER_PLAYWRIGHT__EXECUTABLE_PATH="/usr/bin/chromium-browser"
RENDER_PLAYWRIGHT__LAUNCH_ARGS="--no-sandbox"

# --------------------------------------------------- maimaidx（舞萌 DX 查分 / 猜歌）
# 静态资源目录，必填，必须是绝对路径且指到 `static`
MAIMAIDX_PATH="/home/lighthouse/break/res/maimaidx/static"
# 是否开启别名推送（群友加别名时同步到柚子别名服务器）
MAIMAIDX_ALIAS_PUSH=true
# 是否通过中转访问柚子别名服务器（境内服务器建议 true）
MAIMAIDX_ALIAS_PROXY=false
# 是否把部分图片缓存在内存里
SAVE_IN_MEMORY=true
# 有 icon / plate 资源时可改成 false；没有资源就保持 true（否则落雪查分用不了）
ASSETS_ONLINE=true
# 机器人称呼，不填则取 NICKNAME 的第一个
# BOT_NAME="马歇尔"

# 水鱼查分器（diving-fish）
# 向水鱼申请 OAuth 应用后填 ID 与秘钥，两个都填了才走 OAuth 授权（dfbind）；
# 只填 DIVINGFISH_TOKEN 时用的是已弃用的开发者 token 鉴权——它能按 QQ 号读任意
# 用户的成绩、用户没授权过也撤不回来，水鱼已停止签发，官方让改用 OAuth。
# 两者都配置时优先用 OAuth。
#
# ⚠ 这四个 OAuth 配置项要 maimaidx >= 3.1.0 才认（GitHub 上的 master）：
#   PyPI 目前最新的 3.0.14 里没有 divingfish_client_id / _secret / _auth_url /
#   _scope 这几个字段，装了也不会报错，只是静默失效并退回 DIVINGFISH_TOKEN。
DIVINGFISH_CLIENT_ID=
DIVINGFISH_CLIENT_SECRET=
# OAuth 权限权重之和，默认 4（= prober.records.read），多个权限相加：
#   profile=1  prober.profile.read=2  prober.records.read=4  prober.records.write=8
#   chunithm.records.read=16  chunithm.records.write=32
DIVINGFISH_SCOPE=7
# 水鱼账号地址，一般不用填，默认 https://auth.diving-fish.com
# DIVINGFISH_AUTH_URL=
# 开发者 token（已弃用；配了 OAuth 就优先走 OAuth）
DIVINGFISH_TOKEN=""
# 是否通过中转访问水鱼查分器（境外服务器建议 true）
DIVINGFISH_PROBER_PROXY=false

# 落雪查分器（lxns），全都不填就用不了落雪查分
# LXNS_DEV_TOKEN=            # 开发者 token
# LX_CLIENT_ID=              # OAuth 应用 ID（权限选前三项，不含「读取个人 API 秘钥」）
# LX_CLIENT_SECRET=          # OAuth 应用秘钥
# REDIRECT_URI=              # OAuth 回调地址，要和落雪后台登记的完全一致
# LXNS_BIND_PRIVATE_ONLY=false   # 是否只允许私聊完成 OAuth 绑定，默认群聊私聊都行

# ------------------------------------------------------------- parser（链接解析）
# 这几个键名就是插件里的字段名，没有统一前缀
# B 站 cookie，必须含 SESSDATA，否则解析 B 站会失败
parser_bili_ck=""
# 小红书 cookie，部分链接有不带水印的版本，可填可不填
parser_xhs_ck=""
# youtube cookie，不填容易被判定为人机而下载失败
parser_ytb_ck=""
# 代理，只作用于 youtube / tiktok（推特走环境变量 http_proxy / https_proxy）
# 不用就别配，要配写完整地址；写 `None` 会被当成字符串 "None" 传给 yt-dlp
# parser_proxy=http://127.0.0.1:7890
# 解析出来的音频是否上传成群文件
parser_need_upload=False
# 图片 / 音频 / 视频是否用 base64 发送；会明显吃内存和带宽，仅
# 「机器人和协议端不在同一台机器」时再开
parser_use_base64=False
# 音视频下载大小上限（MB）与时长上限（秒），超过就不解析
parser_max_size=90
parser_duration_maximum=480
# 是否在解析结果的文案里附上原始链接
parser_append_url=False
# 全局禁用的解析平台，可选值：
# acfun / bilibili / douyin / kuaishou / nga / tiktok / twitter / weibo /
# xiaohongshu / youtube
parser_disabled_platforms='["twitter", "kuaishou", "youtube"]'
# B 站视频编码优先级，可选 "avc" / "hev" / "av01"
# parser_bili_video_codes='["avc", "av01", "hev"]'
# B 站视频清晰度：360p=16, 480p=32, 720p=64, 1080p=80, 1080p+=112,
# 1080p60=116, 4k=120
parser_bili_video_quality=80
# 渲染方式："default"（不渲染图片）/ "common"（PIL）/ "htmlrender" / "htmlkit"
parser_render_type="common"
# 自定义渲染字体，把字体文件丢进 localstore 的插件 config 目录再写文件名
# parser_custom_font="LXGWZhenKaiGB-Regular.ttf"
# parser_custom_font_weight=700
# 媒体内容超过 4 项时是否合并转发
parser_need_forward_contents=True
# emoji 渲染用的 CDN 与样式（apple / google / twitter / facebook）
parser_emoji_cdn="https://emojicdn.elk.sh"
parser_emoji_style="google"
# 群黑名单模式：true 表示默认所有群都解析，只屏蔽黑名单里的群
parser_group_blacklist_enabled=True

# ------------------------------------------------------- llmchat（大模型聊天）
# api_presets 是必填项，缺了插件加载会直接报错
LLMCHAT__API_PRESETS='
[
    {
        "name": "deepseek-v4-pro",
        "api_key": "sk-your-api-key",
        "model_name": "deepseek-v4-pro",
        "api_base": "https://api.deepseek.com",
        "support_mcp": false,
        "support_image": false,
        "request_with_reasoning_content": true,
        "extra_body": {"thinking": {"type": "enabled"}}
    },
    {
        "name": "deepseek-flash",
        "api_key": "sk-your-api-key",
        "model_name": "deepseek-v4-flash",
        "api_base": "https://api.deepseek.com",
        "support_mcp": true,
        "support_image": false,
        "request_with_reasoning_content": true,
        "extra_body": {"thinking": {"type": "enabled"}}
    }
]
'
# 上下文保留的消息条数
LLMCHAT__HISTORY_SIZE=20
# 触发时额外带上的历史消息条数
LLMCHAT__PAST_EVENTS_SIZE=10
# 群聊默认用哪个预设，"off" 表示群聊里默认不主动回复
LLMCHAT__DEFAULT_PRESET="off"
# 私聊默认预设与是否启用私聊
LLMCHAT__PRIVATE_CHAT_PRESET="deepseek-v4-pro"
LLMCHAT__ENABLE_PRIVATE_CHAT=true
# 随机插话概率 [0, 1]
LLMCHAT__RANDOM_TRIGGER_PROB=0.05
# 默认提示词
# LLMCHAT__DEFAULT_PROMPT="你的回答应该尽量简洁、幽默，可以带点语气词。"
# API 请求超时、最大工具调用轮数
LLMCHAT__REQUEST_TIMEOUT=30
LLMCHAT__MAX_TOOL_ROUNDS=8
LLMCHAT__MAX_REPEATED_TOOL_CALLS=2
# 消息开头匹配到这些前缀就忽略
# LLMCHAT__IGNORE_PREFIXES=["/"]
# 黑名单用户
# LLMCHAT__BLACKLIST_USER_IDS=[10001]
# MCP 服务器（stdio 用 command，远程用 url，二选一）
# LLMCHAT__MCP_SERVERS='{"web":{"url":"https://example.com/mcp","transport":"streamable_http"}}'

# ------------------------------------------------------------ arcaea-sticker
# 群里发消息时是否自动回复表情包
ARCAEA_REPLY=true

# ----------------------------------------------------------------- memes（表情包）
# 命令前缀，不写就用全局 COMMAND_START
# MEMES_COMMAND_PREFIXES=["/"]
# 禁用的表情名
# MEMES_DISABLED_LIST=["xxx"]
# 启动时检查资源文件是否齐全
MEMES_CHECK_RESOURCES_ON_STARTUP=true
# 参数不匹配时的处理策略：
#   too_much_text / too_much_image: ignore / prompt / drop
#   too_few_text / too_few_image:   ignore / prompt / get
# MEMES_PARAMS_MISMATCH_POLICY='{"too_much_text":"ignore","too_few_text":"ignore","too_much_image":"ignore","too_few_image":"ignore"}'
# 没带图片 / 没带文字时是否用发送者头像 / 默认文案代替
MEMES_USE_SENDER_WHEN_NO_IMAGE=false
MEMES_USE_DEFAULT_WHEN_NO_TEXT=false
# 随机表情是否显示表情信息
MEMES_RANDOM_MEME_SHOW_INFO=true
# 表情列表图片的排序等（留空用默认值）
# MEMES_LIST_IMAGE_CONFIG='{"sort_by":"keywords_pinyin","sort_reverse":false}'
# 一次发多张图时的行为
# MEMES_MULTIPLE_IMAGE_CONFIG='{"direct_send_threshold":10,"send_zip_file":true,"send_forward_msg":false}'

# -------------------------------------------------- greeting（本地插件：早安晚安）
# 几点算新的一天（凌晨两三点说早安不该算第二天）
GREETING__DAY_BOUNDARY_HOUR=4
# 打卡时段，留空表示不限时；结束时间早于开始时间表示跨零点
GREETING__MORNING_START=04:00
GREETING__MORNING_END=11:00
GREETING__NIGHT_START=21:00
GREETING__NIGHT_END=06:00
# SQLite 路径，不写就是 data/greeting/greeting.db
# GREETING__DB_PATH=

# ---------------------------------------- plugin_manager（本地插件：插件管理）
# /插件安装、/插件卸载 只对上面的 SUPERUSERS 开放，并需要服务器上装有 nb-cli
# （已在 requirements.txt 里）
# 插件列表图片每页显示几个（1-30）
PLUGIN_MANAGER__PAGESIZE=9
# 要扫描的本地插件目录
PLUGIN_MANAGER__PLUGIN_DIRS=["src/plugins"]
# 中文字体，不写就自动找系统里的 Noto Sans CJK / 思源黑体 / 文泉驿
# PLUGIN_MANAGER__FONT_PATH=/usr/share/fonts/xxx.ttf
# PLUGIN_MANAGER__FONT_BOLD_PATH=/usr/share/fonts/xxx-bold.ttf
# 是否在列表里显示 NoneBot 内置插件
PLUGIN_MANAGER__SHOW_BUILTIN=true

# -------------------------------------------------------- apscheduler（定时任务）
# 是否随机器人启动
APSCHEDULER_AUTOSTART=true
# 日志等级，30 = WARNING
APSCHEDULER_LOG_LEVEL=30
# 时区等参数，国内机器建议 Asia/Shanghai
APSCHEDULER_CONFIG='{"apscheduler.timezone":"Asia/Shanghai"}'
